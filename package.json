{
  "name": "task-manager-project",
  "version": "1.0.0",
  "description": "Task Manager Project",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "powershell -Command \".venv\\Scripts\\python.exe backend/app.py\"",
    "frontend": "npm run dev --prefix frontend",
    "backend": "powershell -Command \".venv\\Scripts\\python.exe backend/app.py\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
